{
  "name": "@workspace/tickets",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo build dist node_modules",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.2.0",
    "@workspace/common": "workspace:*",
    "@workspace/database": "workspace:*",
    "@workspace/email": "workspace:*",
    "pg-boss": "^11.1.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.8",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*"
  },
  "prettier": "@workspace/prettier-config",
  "exports": {
    ".": "./src/index.ts",
    "./pdf": "./src/pdf/generate-ticket-pdf.ts",
    "./qr": "./src/qr/generate-qr-code.ts",
    "./validation": "./src/validation/validate-purchase.ts",
    "./jobs": "./src/jobs/index.ts"
  }
}
